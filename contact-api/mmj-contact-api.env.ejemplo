# Copiar a /etc/mmj-contact-api.env y completar. Permisos 600, dueño root.
# NUNCA commitear el archivo real con la clave.
PORT=8471
ALLOWED_ORIGINS=https://mmjsystems.cl,https://www.mmjsystems.cl
TO_EMAIL=contacto.mmjsystems@gmail.com
FROM_EMAIL=contacto.mmjsystems@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contacto.mmjsystems@gmail.com
SMTP_PASS=PONER_APP_PASSWORD_DE_GMAIL
RATE_MAX=5
RATE_VENTANA_SEG=3600
STORE_FILE=/var/lib/mmj-contact-api/mensajes.jsonl
LOG_FILE=/var/lib/mmj-contact-api/api.log
