[Unit]
Description=MMJ Systems contact API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mmj-contact-api/app.py
EnvironmentFile=/etc/mmj-contact-api.env
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=mmj-contact-api
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
